cypress-image-diff-screenshots/
cypress-image-diff-html-report/


npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Ignore local Claude Code state, but track committed skills (run-* etc.).
# Each skill dir has its own .gitignore for node_modules/ and screenshots/.
.claude/*
!.claude/skills/
