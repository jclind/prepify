rules_version = '2';

// Firebase Storage security rules for Prepify.
// Deploy with:  firebase deploy --only storage
//
// Model: images are PUBLICLY READABLE (recipe + profile photos are shown across
// the public site), but WRITES require an authenticated user, a 5 MB size cap,
// and an image/* content type. The server's Firebase Admin SDK bypasses these
// rules entirely, so the moderation pipeline is unaffected.
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: stored at profilePhotos/{uid} (AuthContext.tsx), so we can
    // enforce that a user only writes/overwrites/deletes their OWN photo.
    match /profilePhotos/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Recipe images (I2): stored at recipeImages/{uid}/{uuid} (api/recipes.ts), so
    // — like profilePhotos/{uid} above — we can enforce that a user only writes
    // under their OWN uid prefix. The I1 "Resize Images" extension writes its WxH
    // variants into this same {uid}/ directory; the {imageId} wildcard covers them
    // for public read, and the extension writes via the Admin SDK so it bypasses
    // the owner-write check below.
    match /recipeImages/{uid}/{imageId} {
      allow read: if true;
      // New objects only, never an overwrite: the server moderates an image
      // once, when the recipe pointing at it is saved, so an in-place overwrite
      // would swap new content in behind an approved URL. The client always
      // uploads to a fresh uuid, so it never needs to overwrite. `resource ==
      // null` is what enforces it: the Storage emulator treats an overwrite as
      // `create`, so the method name alone doesn't. (Review fix 1f; delete-then-
      // recreate at the same path is still possible, see the 2026-11-06 fix
      // plan, D6.)
      allow create: if request.auth != null
                    && resource == null
                    && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // Owner-scoped delete (X3). The client cleans up its own just-uploaded
      // object when a create/edit fails after the upload (api/recipes.ts
      // deleteRecipeImage); without this grant that cleanup 403s and the
      // orphan leaks.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Legacy recipe images (pre-I2): keyed by bare filename at recipeImages/{file},
    // one segment under recipeImages/ (so disjoint from the uid-scoped match above,
    // whose objects are two segments deep). Kept publicly READABLE so existing
    // recipes keep rendering until these objects are migrated to the uid-scoped
    // path, but writes are DENIED — nothing writes here anymore (uploads re-keyed),
    // and denying closes the old "any signed-in user can overwrite any recipe
    // image" gap for the flat path too. The server Admin SDK bypasses rules, so the
    // owner-run migration is unaffected.
    match /recipeImages/{imageId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is denied. The specific matches above grant access for
    // their paths; any path not matched here falls through to deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
