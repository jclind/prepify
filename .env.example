# Edamam nutrition lookup is now proxied through the Express server
# (POST /api/nutrition/details) so the app id/key stay server-side — set
# EDAMAM_APP_ID / EDAMAM_APP_KEY in server/.env, not here.
VITE_FIREBASE_API_KEY=<your-firebase-api-key>
VITE_FIREBASE_APP_ID=<your-firebase-app-id>
VITE_FIREBASE_AUTH_DOMAIN=<your-firebase-auth-domain>
VITE_FIREBASE_MESSAGING_SENDER_ID=<your-firebase-messaging-sender-id>
VITE_FIREBASE_PROJECT_ID=<your-firebase-project-id>
VITE_FIREBASE_STORAGE_BUCKET=<your-firebase-storage-bucket>
VITE_API_URL=http://localhost:4000
VITE_CYPRESS=false
# Sentry client error monitoring. Leave empty to disable entirely — the app
# no-ops (no init, no reporting) without a DSN, so local dev/CI stay quiet.
VITE_SENTRY_DSN=
