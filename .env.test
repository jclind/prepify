# Enables the Cypress test bridges in src/client/db.ts and src/api/recipes.ts.
# This file is committed. It is loaded with `--mode test` and by Vitest (whose
# mode defaults to "test"), so it is the env the CI test jobs actually see — the
# real .env is gitignored and absent in CI.
VITE_CYPRESS=true

# Pin the API base the test-mode app addresses to :4000 so it matches the host
# the Cypress intercepts target (`cypress/support/constants.ts`). No-op in CI
# (where the default is already :4000), but it overrides a dev worktree's `.env`
# (which may set VITE_API_URL=:4003 to avoid clashing with the main stack) — so
# `cy.intercept` patterns still match the requests the app makes.
VITE_API_URL=http://localhost:4000

# Dummy Firebase config so `src/client/db.ts` can initialize during tests.
# getAuth() throws `auth/invalid-api-key` when the key is empty/missing, which
# crashes any test whose import graph reaches client/db (e.g. Recipes.test via
# useSaveRecipe -> AuthAPI). These are placeholders — tests never make real
# Firebase calls (auth/network is mocked), they only need a non-empty config.
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_STORAGE_BUCKET=test-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-TEST0000
